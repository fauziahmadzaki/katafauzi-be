
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


enum Role {
  ADMIN      
  AUTHOR     
  SUBSCRIBER 
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(SUBSCRIBER) // Default user baru adalah SUBSCRIBER
  image     String? 
  hashedRefreshToken String? @db.Text

  deletedAt DateTime?
  createdById Int?
  createdBy   User? @relation("UsersCreated", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("UsersUpdated", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("UsersDeleted", fields: [deletedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  usersCreated User[] @relation("UsersCreated")
  usersUpdated User[] @relation("UsersUpdated")
  usersDeleted User[] @relation("UsersDeleted")
  posts Post[]  @relation("UserPosts")
  updatedPosts  Post[] @relation("UpdatedPosts")
  deletedPosts  Post[]  @relation("DeletedPosts")
}

model Post{
  id  Int @id @default(autoincrement())
  title String
  slug  String @unique
  content Json
  published Boolean @default(false)

  author  User  @relation("UserPosts", fields: [authorId], references: [id])
  authorId  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  updatedById Int?
  updatedBy User?  @relation("UpdatedPosts", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deletedById Int?
  deletedBy User?  @relation("DeletedPosts", fields: [deletedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

}